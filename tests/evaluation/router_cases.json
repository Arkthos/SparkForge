{
  "schema_version": "sparkforge.router-oracle.v1",
  "id": "fictional-audit-router-oracle",
  "revision": 2,
  "intent_id": "fictional-audit-router",
  "cases": [
    {
      "id": "legacy-read", "kind": "positive", "criteria": ["R1", "R4"],
      "request": {"route": "read", "payload": "one"},
      "dispatch_result": {"receipt": "read-observation", "version": 1},
      "expected": {"value": {"route": "read", "result": {"receipt": "read-observation", "version": 1}}, "error": null, "calls": [["read", "one"]]}
    },
    {
      "id": "legacy-write", "kind": "positive", "criteria": ["R1", "R4"],
      "request": {"route": "write", "payload": " two ", "audit_only": false},
      "dispatch_result": "receipt#73",
      "expected": {"value": {"route": "write", "result": "receipt#73"}, "error": null, "calls": [["write", " two "]]}
    },
    {
      "id": "legacy-read-false", "kind": "positive", "criteria": ["R1", "R4"],
      "request": {"route": "read", "payload": "one", "audit_only": false},
      "dispatch_result": ["opaque", 2],
      "expected": {"value": {"route": "read", "result": ["opaque", 2]}, "error": null, "calls": [["read", "one"]]}
    },
    {
      "id": "legacy-write-default", "kind": "positive", "criteria": ["R1", "R4"],
      "request": {"route": "write", "payload": "one"},
      "dispatch_result": {"ok": true, "receipt": "write-no-audit"},
      "expected": {"value": {"route": "write", "result": {"ok": true, "receipt": "write-no-audit"}}, "error": null, "calls": [["write", "one"]]}
    },
    {
      "id": "audit-read", "kind": "positive", "criteria": ["R2", "R4"],
      "request": {"route": "read", "payload": " one ", "audit_only": true},
      "dispatch_result": null,
      "expected": {"value": {"route": "read", "payload": " one ", "audit_only": true}, "error": null, "calls": []}
    },
    {
      "id": "audit-write", "kind": "positive", "criteria": ["R2", "R4"],
      "request": {"route": "write", "payload": "two", "audit_only": true},
      "dispatch_result": null,
      "expected": {"value": {"route": "write", "payload": "two", "audit_only": true}, "error": null, "calls": []}
    },
    {
      "id": "unknown-route", "kind": "negative", "criteria": ["R3", "R4"],
      "request": {"route": "delete", "payload": "one"},
      "dispatch_result": null,
      "expected": {"value": null, "error": "ValueError", "calls": []}
    },
    {
      "id": "missing-payload", "kind": "negative", "criteria": ["R3", "R4"],
